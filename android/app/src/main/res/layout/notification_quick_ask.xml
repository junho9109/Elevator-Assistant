<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_ask_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/quick_ask_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_quick_ask_mic"
        android:contentDescription="@string/quick_ask_mic_desc"
        android:padding="9dp"
        android:src="@drawable/ic_mic" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_ask_title"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_ask_hint"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
    </LinearLayout>
</LinearLayout>
